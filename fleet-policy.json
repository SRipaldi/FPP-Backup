  "per_unit": [
    "HostName",
    "HostDescription",
    "fppMode",
    "AudioOutput",
    "AudioMixerDevice",
    "ForceAudioId",
    "VideoOutput",
    "InstalledCape",
    "LEDDisplayType",
    "piRTC",
    "EnableTethering",
    "TetherSSID",
    "ClockDate",
    "ClockTime",
    "FPP_UUID",
    "MultiSyncExtraRemotes",
    "MultiSyncRemotes",
    "storageDevice",
    "volume",
    "AudioCardType",
    "AudioCard0Type",
    "UnpartitionedSpace",
    "LastBlock"
  ],
  "secret_pattern": "pass|psk|secret|token|key|MQTTUsername|MQTTHost|email"
